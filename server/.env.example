# ---- Facebook (required) ----
FB_PAGE_ID=your_page_id
FB_PAGE_TOKEN=your_long_lived_page_access_token
FB_API_VERSION=v21.0

# ---- LinkedIn (optional) - profile + company page posting ----
# Create an app at developers.linkedin.com, add products "Share on LinkedIn" (profile)
# and "Community Management API" (company page). Add LI_REDIRECT_URI to the app's Authorized redirect URLs.
LI_CLIENT_ID=your_linkedin_client_id
LI_CLIENT_SECRET=your_linkedin_client_secret
LI_REDIRECT_URI=https://YOUR-APP-URL/linkedin/callback
# Numeric company page id: the number in linkedin.com/company/<id>/admin/ (you must be a page admin)
LI_ORG_ID=
# Remove w_organization_social if you only post to your profile / don't have the company page product yet
LI_SCOPES=openid profile w_member_social w_organization_social
# LinkedIn API version (YYYYMM). Change it if LinkedIn reports the version as no longer supported.
LI_API_VERSION=202609
# Optional alternative to the Connect button: paste a token and your member URN (urn:li:person:xxxx)
# LI_ACCESS_TOKEN=
# LI_PERSON_URN=

# ---- Firebase: accounts (login) + Realtime Database (settings, posts). Free Spark plan is enough. No Storage. ----
# Firebase console > Project settings > General > "Web API key"
FIREBASE_WEB_API_KEY=
# Build > Realtime Database > the URL shown at the top, e.g. https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
# Project settings > Service accounts > Generate new private key. Paste the WHOLE downloaded JSON file here (one line is fine).
FIREBASE_SERVICE_ACCOUNT=
# Optional: only if it differs from project_id inside the service account JSON
# FIREBASE_PROJECT_ID=

# ---- Old password login (only used while the three FIREBASE_ values above are NOT all set) ----
API_KEY=choose_a_long_random_string

# ---- AI text (set at least ONE key). If a key, model or provider fails the app switches to the next one by itself ----
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
# Optional backups (any OpenAI-compatible provider). Order below = order tried.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# AI_CUSTOM_BASE_URL=https://your-provider/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODELS=model-a,model-b
# AI_PROVIDER_ORDER=groq,gemini,openrouter,openai,custom
# Daily AI token cap is set in the dashboard (Marketing AI > Limits). Default 60000 tokens/day.

# ---- Images (required for image posts in automation) ----
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ---- Company details added to every AI post ----
COMPANY_NAME=Araa Software Solutions
COMPANY_WHATSAPP=51884262
COMPANY_WEBSITE=https://araasoftwares.com
COMPANY_EMAIL=info@araasoftwaresm.com

# ---- Automation defaults (can also be changed in the dashboard) ----
# Minutes ahead of UTC for your posting day: Qatar = 180, Sri Lanka = 330
UTC_OFFSET_MINUTES=180
# Only used when Firebase is NOT configured: folder for the local data file (needs a mounted disk on Railway/Render)
DATA_DIR=./data

PORT=3000

# ---- Phase 3 ----
# AI price table (per 1M tokens). Edit pricing.json or point to another file. Costs are ESTIMATES, never invoices.
# PRICING_FILE=./pricing.json
# Alert when the estimated 30-day AI spend reaches 80% / 100% of this (USD). Empty = no budget alert.
# AI_BUDGET_USD_MONTH=
# Optional: POST alerts (warning/critical) to this https webhook (Slack-compatible {"text":...}). Delivery is untested until you configure and test it.
# ALERT_WEBHOOK_URL=
# ALERT_SOURCE_FAILURES=10
# ALERT_QUEUE_BACKLOG=20
# Facebook request timeout in ms (default 30000)
# FB_TIMEOUT_MS=30000

# ---- Phase 4 ----
# EmailJS (alerts to admins + new-post emails to subscribers). In EmailJS: Account > Security > enable "Allow EmailJS API for non-browser applications".
# The template needs these variables: to_email, subject, title, message, post_url (optional: unsubscribe_url, to_name).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Set to 1 only if two alert recipients in one "to" field do not both receive mail (doubles the email count)
# EMAILJS_SPLIT_RECIPIENTS=1
# Your public site address (used in unsubscribe links and welcome emails), e.g. https://araaposts.up.railway.app
PUBLIC_URL=
# Optional: only accept this domain when the super admin creates staff accounts, e.g. araasoftwares.com
# OFFICIAL_EMAIL_DOMAIN=
# LinkedIn analytics for the company page needs the extra scope: LI_SCOPES=openid profile w_member_social w_organization_social r_organization_social

# ---- CORS / security ----
# Browser origins allowed to call the API (comma separated, exact, no trailing slash or path).
# Same-origin always works. Add your separately hosted dashboard(s) and any website that posts to /subscribe.
# "ORGINS" is accepted as an alias of ORIGINS. "*" is rejected on purpose.
ORIGINS=http://localhost:5173,http://localhost:4173,https://araaposts.web.app
