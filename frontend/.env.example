# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Backend URL when the dashboard is hosted separately (e.g. https://araaposts.web.app -> your server).
# Leave empty if the API is served from the same domain. The server must list this site in ORIGINS.
VITE_API_BASE=
# Dev server proxy target for /api and /auth-config
VITE_DEV_PROXY=http://localhost:3000
VITE_ROUTER=
